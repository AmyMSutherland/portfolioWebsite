---
layout: base.njk
title: Projects
description: UX design and coding projects by Amy Sutherland.
permalink: /projects/
---
<div class="wrap">
  <h1>Projects</h1>
  <p class="lead">UX design and coding work.</p>
  <ul class="projects">
    {%- for p in projects %}
    <li class="project">
      <div class="card-media">{% picture p.file, p.alt, "(min-width: 48rem) 35rem, 100vw", "lazy", [400, 800, 1200] %}</div>
      <div>
        {% if p.category %}<span class="tag">{{ p.category }}</span>{% endif %}
        <h2>{{ p.title }}</h2>
        <p>{{ p.summary }}</p>
        {% if p.link %}<p><a href="{{ p.link }}">View {{ p.title }}</a></p>{% endif %}
      </div>
    </li>
    {%- endfor %}
  </ul>
</div>
