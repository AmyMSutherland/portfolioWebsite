  <h1>About me</h1>
  <div class="about">
    <figure class="about-photo">
      {% picture "about/amy-gallery.jpg", "Amy smiling at her college art exhibition, standing in front of a wall of her framed photographs, including a chickadee on a rock, a cat, glowing candles, and a tree against a red sky.", "(min-width: 56rem) 28rem, 100vw", "eager", [500, 960] %}
