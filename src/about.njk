      <h2>Say hello</h2>
      <p>Want to talk photos, art or design? I'd love to hear from you.</p>
      <p><a class="about-email" href="mailto:{{ site.email }}"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>Email me</a></p>
      {%- if site.social.length %}
