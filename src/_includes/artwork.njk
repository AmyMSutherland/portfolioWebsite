{#- One artwork, large. Expects: item, items, pagination, baseUrl, sectionName -#}
{%- set prev = items[pagination.pageNumber - 1] if pagination.pageNumber > 0 else null -%}
{%- set next = items[pagination.pageNumber + 1] if pagination.pageNumber + 1 < items.length else null -%}
<div class="wrap">
  <figure class="artwork">
    <div class="artwork-frame">
      {% picture item.file, item.alt, "(min-width: 72rem) 72rem, 100vw", "eager" %}
      {#- The photos on either side, waiting just out of view so a swipe can slide them in. -#}
      {%- if prev %}<span class="swipe-peek swipe-peek-prev" aria-hidden="true">{% decorativePicture prev.file, "(min-width: 72rem) 72rem, 100vw", "eager", [400, 800, 1200, 2000] %}</span>{% endif %}
      {%- if next %}<span class="swipe-peek swipe-peek-next" aria-hidden="true">{% decorativePicture next.file, "(min-width: 72rem) 72rem, 100vw", "eager", [400, 800, 1200, 2000] %}</span>{% endif %}
      {#- Previous / next arrows on the sides of the photo (also reachable with Tab and announced by screen readers). -#}
      {%- if prev %}<a class="frame-nav frame-nav-prev" href="{{ baseUrl }}{{ prev.title | slugify }}/" rel="prev" aria-label="Previous: {{ prev.title }}"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></a>{% endif %}
      {%- if next %}<a class="frame-nav frame-nav-next" href="{{ baseUrl }}{{ next.title | slugify }}/" rel="next" aria-label="Next: {{ next.title }}"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></a>{% endif %}
    </div>
    {%- if prev %}<link rel="prefetch" href="{{ baseUrl }}{{ prev.title | slugify }}/">{% endif %}
    {%- if next %}<link rel="prefetch" href="{{ baseUrl }}{{ next.title | slugify }}/">{% endif %}
    <figcaption>
      {%- set medium = item.medium or item.category %}
      {%- if medium %}<span class="tag">{{ medium }}</span>{% endif %}
      {#- Logo lettering: first word thin, the rest bold (a one-word title stays thin) -#}
      {%- set words = item.title.split(" ") %}
      <h1 class="logo-heading logo-title"><span class="name-light">{{ words[0] }}</span>{% if words.length > 1 %} <span class="name-bold">{{ words.slice(1).join(" ") }}</span>{% endif %}</h1>
      {#- Years are kept in the data files but not shown, since not every photo has one. -#}
      {%- set caption = item.caption or item.summary %}{% if caption %}<p>{{ caption }}</p>{% endif %}
      {%- if item.link %}<p><a href="{{ item.link }}">{{ item.linkLabel or ("Visit " + item.title) }}</a></p>{% endif %}
    </figcaption>
    <p class="swipe-hint" aria-hidden="true">Swipe or tap the sides for more</p>
  </figure>

  <nav class="pager" aria-label="{{ sectionName }}">
    <ul>
      <li class="pager-all"><a class="pager-btn pager-btn-all" href="{{ baseUrl }}"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><rect x="3" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"/></svg>All {{ sectionName | lower }} <span class="pager-count">({{ pagination.pageNumber + 1 }} of {{ items.length }})</span></a></li>
    </ul>
  </nav>
</div>
<script src="{{ '/js/swipe.js' | bust }}" defer></script>
