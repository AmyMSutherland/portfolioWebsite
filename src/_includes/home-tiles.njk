{#- The three big home page tiles (Photography, Other projects, About me). -#}
<ul class="home-tiles">
  <li>
    <a class="home-tile" href="/photography/">
      <span class="home-tile-strips" aria-hidden="true">
        <span class="strip" style="--pos: 85% 40%; --pos-m: 76% 40%">{% decorativePicture "photography/grammy.jpg", "(min-width: 72rem) 24rem, 34vw", "eager", [500, 900] %}</span>
        <span class="strip" style="--pos: 50% 50%">{% decorativePicture "photography/light-columns.jpg", "(min-width: 72rem) 24rem, 34vw", "eager", [500, 900] %}</span>
        <span class="strip" style="--pos: 6% 78%; --pos-m: 4% 70%">{% decorativePicture "photography/cookie.jpg", "(min-width: 72rem) 24rem, 34vw", "eager", [500, 900] %}</span>
      </span>
      <span class="home-tile-label">
        <span class="home-tile-title"><span class="name-light">Photography</span></span>
        <span class="home-tile-desc">Animals, family and the moments in between</span>
      </span>
    </a>
  </li>
  <li>
    <a class="home-tile" href="/projects/">
      <span class="home-tile-strips" aria-hidden="true">
        <span class="strip" style="--pos: 50% 40%; --pos-m: 50% 45%">{% decorativePicture "projects/petchecker.jpg", "(min-width: 72rem) 24rem, 34vw", "lazy", [500, 900] %}</span>
        <span class="strip" style="--pos: 38% 45%; --pos-m: 42% 40%">{% decorativePicture "projects/friends.jpg", "(min-width: 72rem) 24rem, 34vw", "lazy", [500, 900] %}</span>
        <span class="strip" style="--pos: 0% 62%; --pos-m: 0% 64%">{% decorativePicture "projects/blackjack.jpg", "(min-width: 72rem) 24rem, 34vw", "lazy", [500, 900] %}</span>
      </span>
      <span class="home-tile-label">
        <span class="home-tile-title"><span class="name-light">Other</span> <span class="name-bold">projects</span></span>
        <span class="home-tile-desc">Design, illustration and digital work</span>
      </span>
    </a>
  </li>
  <li>
    <a class="home-tile" href="/about/">
      <span class="home-tile-strips" aria-hidden="true">
        <span class="strip strip-zoom" style="--pos: 36% 50%; --pos-m: 36% 36%">{% decorativePicture "about/amy-gallery.jpg", "(min-width: 72rem) 72rem, 100vw", "lazy", [960] %}</span>
      </span>
      <span class="home-tile-label">
        <span class="home-tile-title"><span class="name-light">About</span> <span class="name-bold">me</span></span>
        <span class="home-tile-desc">Why I love photography, and how to get in touch</span>
      </span>
    </a>
  </li>
</ul>
