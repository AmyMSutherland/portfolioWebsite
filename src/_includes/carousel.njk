{#- Big photo carousel of favorites (listed in src/_data/favorites.js).
    No auto-play, so nothing moves unless the visitor asks it to.
    Without JavaScript it is still a row of photos you can swipe or scroll sideways. -#}
{%- set slides = favorites %}
<section class="carousel" aria-roledescription="carousel" aria-label="Favorite photos">
  <div class="carousel-stage">
    {#- Name and intro, laid over the photos so they stay at the top of the page. -#}
    <div class="carousel-intro">
      <h1 class="carousel-name">{{ site.name }}</h1>
      <p class="carousel-tagline">Photography · Illustration · Design</p>
    </div>
    <div class="carousel-track" id="carousel-track">
      {%- for item in slides %}
      <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ slides.length }}: {{ item.title }}">
        <a class="carousel-link" href="/photography/{{ item.title | slugify }}/">
          <span class="carousel-media">
            {#- A blurred copy of the photo fills the space beside it (decorative only). -#}
            <span class="carousel-backdrop" style="background-image: url('{% imageUrl item.file, 400 %}')" aria-hidden="true"></span>
            {% picture item.file, item.alt, "100vw", ("eager" if loop.first else "lazy"), [800, 1200, 2000] %}
          </span>
          <span class="carousel-caption"><span class="carousel-title">{{ item.title }}</span>{% if item.caption %}<span class="carousel-text">{{ item.caption }}</span>{% endif %}</span>
        </a>
      </div>
      {%- endfor %}
    </div>
  </div>
  <div class="carousel-controls" hidden>
    <button type="button" class="carousel-btn" data-dir="-1" aria-controls="carousel-track"><span aria-hidden="true">←</span><span class="visually-hidden">Previous photo</span></button>
    <div class="carousel-thumbs">
      {%- for item in slides %}
      <button type="button" class="carousel-dot" data-index="{{ loop.index0 }}" aria-controls="carousel-track"><img src="{% imageUrl item.file, 400 %}" alt="" width="96" height="64" loading="lazy" decoding="async"><span class="visually-hidden">Show {{ item.title }}</span></button>
      {%- endfor %}
    </div>
    <button type="button" class="carousel-btn" data-dir="1" aria-controls="carousel-track"><span aria-hidden="true">→</span><span class="visually-hidden">Next photo</span></button>
  </div>
  <p class="visually-hidden" aria-live="polite" id="carousel-status"></p>
</section>
