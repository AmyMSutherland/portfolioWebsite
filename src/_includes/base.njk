<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="color-scheme" content="light dark">
  {%- if page.url != "/404.html" %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- endif %}
  {#- Link previews (texts, social media): a photo's own page shares that photo;
      other pages share the image named in their front matter, or the first photo. -#}
  {%- set shareFile = item.file if (item and item.file) else (shareImageFile or photography[0].file) %}
  {%- set shareAlt = item.alt if (item and item.alt) else (shareImageAlt or photography[0].alt) %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{% shareImage shareFile %}">
  <meta property="og:image:alt" content="{{ shareAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="{{ '/favicon.ico' | bust }}" sizes="any">
  <link rel="icon" href="{{ '/favicon.svg' | bust }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | bust }}">
  <script>
    // Apply a saved light/dark choice before the page draws, so it doesn't flash.
    try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="stylesheet" href="{{ '/css/styles.css' | bust }}">
  <script src="{{ '/js/theme.js' | bust }}" defer></script>
  <script src="{{ '/js/wall.js' | bust }}" defer></script>
  {%- if page.url == "/" %}
  <script src="{{ '/js/carousel.js' | bust }}" defer></script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>
        <img class="brand-logo logo-on-light" src="/logo.png" alt="{{ site.name }}" width="156" height="52">
        <img class="brand-logo logo-on-dark" src="/logo-light-text.png" alt="{{ site.name }}" width="156" height="52">
      </a>
      <nav aria-label="Main">
        <ul class="nav-list">
          {%- for item in site.nav %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% elif page.url.startsWith(item.url) %} aria-current="true"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false" hidden>
        <span class="visually-hidden">Dark theme</span>
        <span class="theme-knob" aria-hidden="true"></span>
        <svg class="theme-sun" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-moon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z"/></svg>
      </button>
    </div>
  </header>

  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <p class="footer-name"><a class="footer-home" href="/"><img src="{{ '/favicon.svg' | bust }}" alt="Home" width="32" height="32"></a> © {{ "" | year }} {{ site.name }}</p>
      <p class="footer-contact">
        <a class="footer-email" href="mailto:{{ site.email }}">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          {{ site.email }}
        </a>
        {%- for link in site.social %} <a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
      </p>
    </div>
  </footer>
</body>
</html>
